# Variabili d'ambiente per il backend Messale Digitale
# Copia questo file come .env e compila i valori

# MongoDB connection string (Atlas)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nome database dove salvare la cache delle letture
DB_NAME=messale

# Porta di ascolto (Render la imposta automaticamente)
PORT=8001
