{"dependencies":[],"output":[{"data":{"code":"__d(function(global, require, _importDefaultUnused, _importAllUnused, module, exports, _dependencyMapUnused) {\n  module.exports = {\n  \"blessings\": [\n    {\n      \"id\": \"avvento\",\n      \"season\": \"avvento\",\n      \"title\": \"Benedizione Solenne dell'Avvento\",\n      \"rubric\": \"Nelle domeniche e nelle celebrazioni più solenni dell'Avvento.\",\n      \"invocations\": [\n        {\n          \"c\": \"Il Dio della fedeltà che ha mantenuto le sue promesse con l'invio del suo Figlio unigenito, vi conceda la gioia della sua venuta e vi renda forti nella fede.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"La sua parola, che si è fatta carne per la nostra salvezza, guidi i vostri passi e illumini il vostro cammino nella luce del Vangelo.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Cristo, che vive in mezzo a noi, vi aiuti a riconoscerlo nel volto del prossimo e a vivere con speranza l'attesa della sua venuta nella gloria.\",\n          \"a\": \"Amen.\"\n        }\n      ],\n      \"final\": {\n        \"c\": \"E la benedizione di Dio onnipotente, Padre e Figlio ✠ e Spirito Santo, discenda su di voi e con voi rimanga sempre.\",\n        \"a\": \"Amen.\"\n      }\n    },\n    {\n      \"id\": \"natale\",\n      \"season\": \"natale\",\n      \"title\": \"Benedizione Solenne del Natale\",\n      \"rubric\": \"Nella Messa del giorno e nelle domeniche del tempo di Natale.\",\n      \"invocations\": [\n        {\n          \"c\": \"Dio, Padre infinitamente buono, che nell'incarnazione del suo Figlio ha dissipato le tenebre del mondo e con la sua nascita gloriosa ha illuminato questa notte santissima (questo giorno santissimo), dissipi da voi le tenebre del peccato e vi irradi con la luce della sua santità.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Dio, che ha voluto con il mistero del Natale iniziare la riconciliazione del cielo con la terra, vi colmi della sua pace e del suo amore, e vi renda partecipi della comunione della Chiesa.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Cristo, Figlio di Dio fatto uomo, che si è posto nell'umiltà di un bambino per noi, vi conceda la gioia che viene dalla pace profonda del cuore, e vi faccia servi della giustizia nella vita di ogni giorno.\",\n          \"a\": \"Amen.\"\n        }\n      ],\n      \"final\": {\n        \"c\": \"E la benedizione di Dio onnipotente, Padre e Figlio ✠ e Spirito Santo, discenda su di voi e con voi rimanga sempre.\",\n        \"a\": \"Amen.\"\n      }\n    },\n    {\n      \"id\": \"quaresima\",\n      \"season\": \"quaresima\",\n      \"title\": \"Benedizione Solenne della Quaresima\",\n      \"rubric\": \"Nelle domeniche di Quaresima e nelle celebrazioni più solenni.\",\n      \"invocations\": [\n        {\n          \"c\": \"Dio, Padre di misericordia, che nel suo Figlio ci ha dato l'esempio di un amore senza misura, vi conceda, con il dono della sua benedizione, di perseverare con gioia nelle opere della penitenza.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Coloro che si dispongono con cuore sincero alla Pasqua possano rinnovare sé stessi in questo tempo di grazia, e perseverare nel bene.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"A tutti voi, pellegrini sulla terra, che camminate verso la Pasqua eterna, Dio conceda la pace del cuore, la gioia dello Spirito e la partecipazione piena al mistero della redenzione.\",\n          \"a\": \"Amen.\"\n        }\n      ],\n      \"final\": {\n        \"c\": \"E la benedizione di Dio onnipotente, Padre e Figlio ✠ e Spirito Santo, discenda su di voi e con voi rimanga sempre.\",\n        \"a\": \"Amen.\"\n      }\n    },\n    {\n      \"id\": \"pasqua\",\n      \"season\": \"pasqua\",\n      \"title\": \"Benedizione Solenne di Pasqua\",\n      \"rubric\": \"Nella Veglia Pasquale, nel giorno di Pasqua e in tutta l'ottava.\",\n      \"invocations\": [\n        {\n          \"c\": \"Dio, che con la risurrezione del suo unico Figlio vi ha aperto la porta della vita eterna, vi conceda il dono della sua benedizione pasquale.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Dio, che nella risurrezione del suo Figlio ci ha ridato la vera libertà e la gioia dello Spirito, vi conceda di vivere pienamente la Pasqua di Cristo nell'attesa della vita eterna.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Voi, che per la celebrazione del mistero pasquale avete concluso i giorni della passione, partecipiate alla gioia della Pasqua e giungiate con esultanza alla festa senza fine.\",\n          \"a\": \"Amen.\"\n        }\n      ],\n      \"final\": {\n        \"c\": \"E la benedizione di Dio onnipotente, Padre e Figlio ✠ e Spirito Santo, discenda su di voi e con voi rimanga sempre.\",\n        \"a\": \"Amen.\"\n      }\n    },\n    {\n      \"id\": \"ascensione\",\n      \"season\": \"pasqua\",\n      \"title\": \"Benedizione Solenne dell'Ascensione\",\n      \"rubric\": \"Nella solennità dell'Ascensione del Signore.\",\n      \"invocations\": [\n        {\n          \"c\": \"Dio, Re della gloria, Signore di potenza, che oggi ha innalzato al cielo nella gloria del trionfo il Cristo suo Figlio vincitore del peccato e della morte, vi conceda la gioia di seguirlo nel suo regno di vita.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Cristo, che dopo la sua risurrezione si è manifestato ai discepoli, oggi sale al cielo, dove vi attende nel giorno della promessa: egli vi conceda, con i suoi doni spirituali, di essere nel mondo testimoni fedeli della sua vita nuova.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Il Signore, che è asceso sopra tutti i cieli, a tutti e a ciascuno di voi doni il suo Spirito, perché possiate conseguire la dimora eterna, dove egli è andato a prepararvi un posto.\",\n          \"a\": \"Amen.\"\n        }\n      ],\n      \"final\": {\n        \"c\": \"E la benedizione di Dio onnipotente, Padre e Figlio ✠ e Spirito Santo, discenda su di voi e con voi rimanga sempre.\",\n        \"a\": \"Amen.\"\n      }\n    },\n    {\n      \"id\": \"pentecoste\",\n      \"season\": \"pasqua\",\n      \"title\": \"Benedizione Solenne di Pentecoste\",\n      \"rubric\": \"Nella solennità di Pentecoste.\",\n      \"invocations\": [\n        {\n          \"c\": \"Dio, Padre della luce, che ha illuminato le menti dei discepoli con l'effusione dello Spirito Paraclito, vi conceda la gioia della sua benedizione e vi renda sempre ricolmi dei suoi doni.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Il fuoco che apparve sopra i discepoli purifichi i vostri cuori da ogni male e li riempia del suo ardore di luce.\",\n          \"a\": \"Amen.\"\n        },\n        {\n          \"c\": \"Lo Spirito Santo, che ha riunito i popoli diversi nell'unica fede, vi renda perseveranti nella fede stessa e vi faccia passare, nella speranza, dalla fede alla visione.\",\n          \"a\": \"Amen.\"\n        }\n      ],\n      \"final\": {\n        \"c\": \"E la benedizione di Dio onnipotente, Padre e Figlio ✠ e Spirito Santo, discenda su di voi e con voi rimanga sempre.\",\n        \"a\": \"Amen.\"\n      }\n    }\n  ],\n  \"pasqua_dismissal\": {\n    \"id\": \"pasqua_alleluia\",\n    \"label\": \"Congedo pasquale (con Alleluia)\",\n    \"rubric\": \"Nella Veglia Pasquale e in tutta l'ottava di Pasqua.\",\n    \"celebrante\": \"Andate in pace. Alleluia, alleluia.\",\n    \"assemblea\": \"Rendiamo grazie a Dio. Alleluia, alleluia.\"\n  }\n};\n});","lineCount":157,"map":[[157,3]],"functionMap":null},"type":"js/module"}]}