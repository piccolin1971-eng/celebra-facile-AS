{"dependencies":[],"output":[{"data":{"code":"__d(function(global, require, _importDefaultUnused, _importAllUnused, module, exports, _dependencyMapUnused) {\n  module.exports = [\n  {\n    \"id\": \"ss_trinita\",\n    \"title\": \"Santissima Trinità\",\n    \"color\": \"bianco\",\n    \"preface_id\": \"ss_trinita\",\n    \"occasions\": \"Si celebra in onore della Santissima Trinità in giorni feriali del Tempo Ordinario.\",\n    \"antifona_ingresso\": \"Sia benedetto Dio Padre, e l'unigenito Figlio di Dio, e lo Spirito Santo: perché grande è il suo amore per noi (cfr. Tb 12, 6).\",\n    \"antifona_comunione\": \"Voi siete figli di Dio: Dio ha mandato nei vostri cuori lo Spirito del suo Figlio, che grida: «Abbà, Padre!» (cfr. Gal 4, 6).\",\n    \"rubric\": \"Per le orazioni proprie (Colletta, Sulle offerte, Dopo la comunione) consultare il Messale Romano alla sezione «Messe votive – Della Santissima Trinità».\"\n  },\n  {\n    \"id\": \"spirito_santo\",\n    \"title\": \"Dello Spirito Santo\",\n    \"color\": \"rosso\",\n    \"preface_id\": \"pentecoste\",\n    \"occasions\": \"Si celebra per invocare i doni dello Spirito Santo, particolarmente in inizio d'anno scolastico, prima di assemblee, sinodi, riunioni pastorali.\",\n    \"antifona_ingresso\": \"L'amore di Dio è stato riversato nei nostri cuori per mezzo dello Spirito Santo che ci è stato dato (Rm 5, 5).\",\n    \"antifona_comunione\": \"Lo Spirito stesso attesta al nostro spirito che siamo figli di Dio (Rm 8, 16).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe votive – Dello Spirito Santo».\"\n  },\n  {\n    \"id\": \"ss_sacramento\",\n    \"title\": \"Del Santissimo Sacramento\",\n    \"color\": \"bianco\",\n    \"preface_id\": \"ss_eucaristia_1\",\n    \"occasions\": \"Si celebra in onore dell'Eucaristia, in occasione di adorazioni eucaristiche, processioni e feste eucaristiche.\",\n    \"antifona_ingresso\": \"Egli li ha nutriti col fiore di frumento, li ha saziati con miele dalla roccia (cfr. Sal 80, 17).\",\n    \"antifona_comunione\": \"Chi mangia la mia carne e beve il mio sangue dimora in me e io in lui, dice il Signore (Gv 6, 56).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe votive – Del Santissimo Sacramento».\"\n  },\n  {\n    \"id\": \"ss_nome_gesu\",\n    \"title\": \"Del Santissimo Nome di Gesù\",\n    \"color\": \"bianco\",\n    \"preface_id\": \"comune_2\",\n    \"occasions\": \"Si celebra in onore del Santo Nome di Gesù, particolarmente il 3 gennaio.\",\n    \"antifona_ingresso\": \"Nel nome di Gesù ogni ginocchio si pieghi nei cieli, sulla terra e sotto terra; e ogni lingua proclami: Gesù Cristo è il Signore, a gloria di Dio Padre (Fil 2, 10-11).\",\n    \"antifona_comunione\": \"Tutto quello che fate in parole ed opere, tutto si compia nel nome del Signore Gesù (Col 3, 17).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe votive – Del Santissimo Nome di Gesù».\"\n  },\n  {\n    \"id\": \"preziosissimo_sangue\",\n    \"title\": \"Del Preziosissimo Sangue di Cristo\",\n    \"color\": \"rosso\",\n    \"preface_id\": \"ss_eucaristia_2\",\n    \"occasions\": \"Si celebra in onore del Sangue di Cristo versato per la nostra salvezza.\",\n    \"antifona_ingresso\": \"Ci hai redenti, Signore, con il tuo Sangue, da ogni tribù, lingua, popolo e nazione, e hai fatto di noi, per il nostro Dio, un regno (cfr. Ap 5, 9-10).\",\n    \"antifona_comunione\": \"Il calice della benedizione che noi benediciamo, non è forse comunione con il sangue di Cristo? (1 Cor 10, 16).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe votive – Del Preziosissimo Sangue di Cristo».\"\n  },\n  {\n    \"id\": \"sacro_cuore\",\n    \"title\": \"Del Sacro Cuore di Gesù\",\n    \"color\": \"bianco\",\n    \"preface_id\": \"sacro_cuore\",\n    \"occasions\": \"Si celebra in onore del Sacratissimo Cuore di Gesù, particolarmente nei primi venerdì del mese.\",\n    \"antifona_ingresso\": \"I disegni del suo cuore per tutte le generazioni: liberare dalla morte e nutrire in tempo di fame (cfr. Sal 32, 11.19).\",\n    \"antifona_comunione\": \"«Uno dei soldati con la lancia gli colpì il fianco, e subito ne uscì sangue e acqua» (Gv 19, 34).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe votive – Del Sacratissimo Cuore di Gesù».\"\n  },\n  {\n    \"id\": \"bvm\",\n    \"title\": \"Della Beata Vergine Maria\",\n    \"color\": \"bianco\",\n    \"preface_id\": \"bvm_1\",\n    \"occasions\": \"Si celebra in onore della Beata Vergine Maria, particolarmente il sabato durante il Tempo Ordinario.\",\n    \"antifona_ingresso\": \"Salve, santa Madre: tu hai dato alla luce il Re che governa il cielo e la terra per i secoli eterni.\",\n    \"antifona_comunione\": \"Beato il grembo della Vergine Maria che ha portato il Figlio dell'eterno Padre.\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe della Beata Vergine Maria nel Tempo Ordinario». Sono disponibili 46 formulari mariani diversi.\"\n  },\n  {\n    \"id\": \"angeli\",\n    \"title\": \"Degli Angeli\",\n    \"color\": \"bianco\",\n    \"preface_id\": \"angeli\",\n    \"occasions\": \"Si celebra in onore dei Santi Angeli, particolarmente per intercedere a tutela della Chiesa e dei fedeli.\",\n    \"antifona_ingresso\": \"Benedite il Signore, voi tutti suoi angeli, potenti esecutori dei suoi comandi, pronti alla voce della sua parola (Sal 102, 20).\",\n    \"antifona_comunione\": \"Alla presenza degli angeli a te canterò, mio Dio (cfr. Sal 137, 1).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe votive – Dei Santi Angeli».\"\n  },\n  {\n    \"id\": \"ss_apostoli\",\n    \"title\": \"Dei Santi Apostoli Pietro e Paolo\",\n    \"color\": \"rosso\",\n    \"preface_id\": \"apostoli_1\",\n    \"occasions\": \"Si celebra in onore dei Santi Apostoli Pietro e Paolo, fondamento della Chiesa.\",\n    \"antifona_ingresso\": \"Questi sono i santi che il Signore ha scelto nel suo amore di carità, ha dato loro gloria eterna (cfr. Sir 44, 25).\",\n    \"antifona_comunione\": \"Tu sei Pietro, e su questa pietra edificherò la mia Chiesa (Mt 16, 18).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe votive – Dei Santi Apostoli».\"\n  },\n  {\n    \"id\": \"tutti_santi\",\n    \"title\": \"Di Tutti i Santi\",\n    \"color\": \"bianco\",\n    \"preface_id\": \"santi_1\",\n    \"occasions\": \"Si celebra in onore di tutti i Santi, per loro intercessione.\",\n    \"antifona_ingresso\": \"Rallegriamoci tutti nel Signore, in questa festa di tutti i Santi: con noi gioiscono gli Angeli e lodano il Figlio di Dio.\",\n    \"antifona_comunione\": \"Beati i puri di cuore, perché vedranno Dio. Beati i misericordiosi, perché troveranno misericordia. Beati i perseguitati per la giustizia, perché di essi è il regno dei cieli (Mt 5, 8-10).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe votive – Di Tutti i Santi».\"\n  },\n  {\n    \"id\": \"defunti\",\n    \"title\": \"Per i fedeli defunti\",\n    \"color\": \"viola\",\n    \"preface_id\": \"defunti_1\",\n    \"occasions\": \"Si celebra in suffragio dei defunti, per le esequie, anniversari, commemorazioni.\",\n    \"antifona_ingresso\": \"L'eterno riposo dona loro, o Signore, e splenda ad essi la luce perpetua.\",\n    \"antifona_comunione\": \"Splenda ad essi la luce perpetua, o Signore, con i tuoi santi in eterno: perché tu sei buono. L'eterno riposo dona loro, o Signore, e splenda ad essi la luce perpetua, con i tuoi santi in eterno: perché tu sei buono (4 Esd 2, 35.34).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alle sezioni «Messa per i fedeli defunti» e «Messe esequiali». Sono disponibili formulari per esequie, anniversari, varie commemorazioni.\"\n  },\n  {\n    \"id\": \"sposi\",\n    \"title\": \"Per gli sposi\",\n    \"color\": \"bianco\",\n    \"preface_id\": \"comune_1\",\n    \"occasions\": \"Si celebra nel rito del Matrimonio o in occasione di anniversari di Matrimonio.\",\n    \"antifona_ingresso\": \"Il Signore vi mandi aiuto dal suo santuario; vi sostenga da Sion. Vi conceda secondo il vostro cuore (cfr. Sal 19, 3.5).\",\n    \"antifona_comunione\": \"Il Signore è buono con tutti, la sua tenerezza si espande su tutte le creature (cfr. Sal 144, 9).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Rito del Matrimonio e il Messale Romano alla sezione «Messe per gli sposi».\"\n  },\n  {\n    \"id\": \"malati\",\n    \"title\": \"Per gli infermi\",\n    \"color\": \"viola\",\n    \"preface_id\": \"comune_2\",\n    \"occasions\": \"Si celebra per pregare per gli infermi e ottenere loro salute spirituale e fisica.\",\n    \"antifona_ingresso\": \"Ricordati, Signore, della tua misericordia e del tuo amore, che sono da sempre (Sal 24, 6).\",\n    \"antifona_comunione\": \"Egli ha preso le nostre infermità e si è caricato delle nostre malattie (Mt 8, 17).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe per gli infermi».\"\n  },\n  {\n    \"id\": \"pace\",\n    \"title\": \"Per la pace e la giustizia\",\n    \"color\": \"viola\",\n    \"preface_id\": \"comune_3\",\n    \"occasions\": \"Si celebra per implorare il dono della pace e della giustizia nel mondo.\",\n    \"antifona_ingresso\": \"Dona, Signore, la pace a chi spera in te, perché la voce dei tuoi profeti si dimostri vera (cfr. Sir 36, 18-19).\",\n    \"antifona_comunione\": \"Vi do la mia pace, vi lascio la mia pace, dice il Signore (Gv 14, 27).\",\n    \"rubric\": \"Per le orazioni proprie consultare il Messale Romano alla sezione «Messe e orazioni per varie necessità – Per la pace e la giustizia».\"\n  }\n]\n;\n});","lineCount":145,"map":[[145,3]],"functionMap":null},"type":"js/module"}]}